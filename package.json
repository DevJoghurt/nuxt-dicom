{
  "name": "@nuxthealth/dicom",
  "version": "0.2.0-beta.2",
  "description": "Nuxt module for DICOM",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DevJoghurt/nuxt-dicom.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn dev:prepare && nuxt-module-build build",
    "prepack": "yarn build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bumpp && npm publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "cleanup": "rimraf 'playground/node_modules' 'node_modules'",
    "bumpp": "bumpp"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@nhealth/nutils": "^0.0.3",
    "@nuxt/kit": "^4.3.0",
    "@nuxthealth/node-dicom": "0.2.1",
    "defu": "^6.1.4",
    "read-last-lines": "^1.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.13.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxt/ui": "4.4.0",
    "@types/node": "^25.0.10",
    "bumpp": "10.4.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.2",
    "happy-dom": "^20.3.9",
    "nuxi": "^3.32.0",
    "nuxt": "^4.3.0",
    "nuxt-mcp-dev": "^0.3.2",
    "rimraf": "^6.1.2",
    "typescript": "latest",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "yarn@4.9.2"
}
