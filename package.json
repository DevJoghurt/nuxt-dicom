{
  "name": "@nuxthealth/dicom",
  "version": "0.1.3",
  "description": "Nuxt module for DICOM",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DevJoghurt/nuxt-dicom.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn dev:prepare && nuxt-module-build build",
    "prepack": "yarn build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bumpp && npm publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "cleanup": "rimraf 'playground/node_modules' 'node_modules'",
    "bumpp": "bumpp"
  },
  "dependencies": {
    "@nuxt/kit": "^3.17.7",
    "@nuxthealth/node-dicom": "0.1.0",
    "defu": "^6.1.4",
    "read-last-lines": "^1.8.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.2",
    "@nuxt/eslint-config": "^1.5.2",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^3.17.7",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxt/ui": "3.2.0",
    "@types/node": "^24.0.14",
    "bumpp": "10.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.31.0",
    "happy-dom": "^18.0.1",
    "nuxi": "^3.26.0",
    "nuxt": "^3.17.7",
    "rimraf": "^6.0.1",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  },
  "packageManager": "yarn@4.9.2"
}
