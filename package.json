{
  "name": "@nuxthealth/dicom",
  "version": "0.1.0",
  "description": "Nuxt module for DICOM",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DevJoghurt/nuxt-dicom.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn dev:prepare && nuxt-module-build build",
    "prepack": "yarn build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bumpp && npm publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "cleanup": "rimraf 'playground/node_modules' 'node_modules'",
    "bumpp": "bumpp"
  },
  "dependencies": {
    "@nuxt/kit": "^3.15.4",
    "@nuxthealth/node-dicom": "0.0.21",
    "zod": "^3.24.1",
    "read-last-lines": "^1.8.0",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.0.0",
    "nuxi": "^3.21.1",
    "@nuxt/eslint-config": "^1.0.1",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.15.4",
    "@nuxt/test-utils": "^3.15.4",
    "@nuxt/ui": "3.0.0-alpha.12",
    "bumpp": "10.0.2",
    "@types/node": "^22.13.1",
    "changelogen": "^0.5.7",
    "eslint": "^9.20.0",
    "nuxt": "^3.15.4",
    "typescript": "latest",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0",
    "rimraf": "^6.0.1"
  }
}
